{
  "manifest_version": 3,
  "name": "Yad2 Watcher",
  "version": "1.0.0",
  "description": "בודק כל רבע שעה האם יש מודעות חדשות בחיפוש הרכב שלך ב-Yad2 ומקפיץ פופאפ.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "storage", "notifications", "tabs", "scripting", "windows"],
  "host_permissions": ["https://www.yad2.co.il/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yad2 Watcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
